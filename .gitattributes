# Preserve exact published M3U/report/manifest bytes across Windows and Linux.
# Their SHA-256 checksums are of bytes, not normalized text.
*.m3u -text
*.json -text

# Keep source and documentation readable with stable LF on all systems.
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# `firmware/` is the exact, immutable source snapshot from v0.7z9.
# Keep its original bytes: SHA256-SOURCES.txt must remain verifiable even
# when cloning this repository on a different operating system.
firmware/** -text
